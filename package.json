{
	"name": "acrobatics-astro",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"astro": "astro",
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"lint:type": "astro check",
		"lint:type:fix": "astro check",
		"lint:style": "stylelint \"./**/*.{css,sass,scss,astro}\" --aei",
		"lint:style:fix": "stylelint \"./**/*.{css,sass,scss,astro}\" --aei --fix",
		"format": "prettier . -c -u --cache",
		"format:fix": "prettier . -w -u --cache",
		"check": "npm run lint:type && npm run lint:style && npm run format",
		"check:fix": "npm run lint:type:fix && npm run lint:style:fix && npm run format:fix"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@playform/compress": "^0.2.3",
		"@types/postcss-pxtorem": "^6.1.0",
		"astro": "^6.4.6",
		"postcss": "^8.5.15",
		"postcss-load-config": "^6.0.1",
		"postcss-preset-env": "^11.3.0",
		"postcss-pxtorem": "^6.1.0",
		"prettier": "^3.8.4",
		"prettier-plugin-astro": "^0.14.1",
		"sass": "^1.101.0",
		"stylelint": "^17.13.0",
		"stylelint-config-html": "^1.1.0",
		"stylelint-config-recess-order": "^7.7.0",
		"stylelint-config-recommended-scss": "^17.0.1",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-order": "^8.1.1",
		"stylelint-scss": "^7.2.0",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.3"
	}
}
