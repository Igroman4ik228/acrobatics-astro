---
import cls from './gallery.module.scss';
---

<!-- Галерея фото -->
<section class={cls.section} id='gallery'>
	<div class='container'>
		<h2 class='section-title' data-aos='fade-up'>Галерея</h2>

		<div class={cls.grid}>
			<figure class={cls.item} data-aos='fade-up'>
				<img
					src={`${import.meta.env.BASE_URL}img/gallery/photo-1.jpg`}
					alt='Дети на тренировке - элементы акробатики'
					class={cls.img}
					loading='lazy'
				/>
				<figcaption class={cls.caption}>
					Групповая тренировка
				</figcaption>
			</figure>

			<figure class={cls.item} data-aos='fade-up'>
				<img
					src={`${import.meta.env.BASE_URL}img/gallery/photo-2.jpg`}
					alt='Юные спортсмены выполняют трюки'
					class={cls.img}
					loading='lazy'
				/>
				<figcaption class={cls.caption}>
					Обучение элементам
				</figcaption>
			</figure>

			<figure class={cls.item} data-aos='fade-up'>
				<img
					src={`${import.meta.env.BASE_URL}img/gallery/photo-3.jpg`}
					alt='Тренер София проводит индивидуальное занятие'
					class={cls.img}
					loading='lazy'
				/>
				<figcaption class={cls.caption}>
					Индивидуальная работа
				</figcaption>
			</figure>

			<figure class={cls.item} data-aos='fade-up'>
				<img
					src={`${import.meta.env.BASE_URL}img/gallery/photo-4.jpg`}
					alt='Дети выполняют акробатические элементы'
					class={cls.img}
					loading='lazy'
				/>
				<figcaption class={cls.caption}>
					Парная акробатика
				</figcaption>
			</figure>

			<figure class={cls.item} data-aos='fade-up'>
				<img
					src={`${import.meta.env.BASE_URL}img/gallery/photo-5.jpg`}
					alt='Переворот через голову, базовый элемент'
					class={cls.img}
					loading='lazy'
				/>
				<figcaption class={cls.caption}>Базовые элементы</figcaption>
			</figure>

			<figure class={cls.item} data-aos='fade-up'>
				<img
					src={`${import.meta.env.BASE_URL}img/gallery/photo-6.jpg`}
					alt='Радостные эмоции детей на занятиях акробатикой в зале'
					class={cls.img}
					loading='lazy'
				/>
				<figcaption class={cls.caption}>
					Большое количество успешных учеников
				</figcaption>
			</figure>

			<figure class={cls.item} data-aos='fade-up'>
				<img
					src={`${import.meta.env.BASE_URL}img/gallery/photo-7.jpg`}
					alt='Юная акробатка улыбается после выполнения сложного элемента'
					class={cls.img}
					loading='lazy'
				/>
				<figcaption class={cls.caption}>
					Успехи наших учеников
				</figcaption>
			</figure>

			<figure class={cls.item} data-aos='fade-up'>
				<img
					src={`${import.meta.env.BASE_URL}img/gallery/photo-8.jpg`}
					alt='Счастливые дети на групповой тренировке по гимнастике'
					class={cls.img}
					loading='lazy'
				/>
				<figcaption class={cls.caption}>
					Успехи наших учеников
				</figcaption>
			</figure>

			<figure class={cls.item} data-aos='fade-up'>
				<img
					src={`${import.meta.env.BASE_URL}img/gallery/photo-9.jpg`}
					alt='Успехи учеников нашей детской школы акробатики'
					class={cls.img}
					loading='lazy'
				/>
				<figcaption class={cls.caption}>
					Успехи наших учеников
				</figcaption>
			</figure>
		</div>
	</div>
</section>
