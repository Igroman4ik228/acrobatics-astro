---
import cls from './header.module.scss';
---

<header class={cls.header}>
	<div class={cls.container}>
		<div class={cls.wrapper}>
			<div class={cls.logo} aria-label='Логотип Acrobatics'>
				<a href='#' class='logo__link'>
					<h3 class='logo__accent'>Acrobatics</h3>
				</a>
			</div>

			<nav class={cls.nav} aria-label='Основная навигация'>
				<ul class={cls.list}>
					<li>
						<a href='#about'>Наши тренеры</a>
					</li>
					<li>
						<a href='#programs'>Программа</a>
					</li>
					<li>
						<a href='#gallery'>Галерея</a>
					</li>
					<li>
						<a href='#reviews'>Отзывы</a>
					</li>
					<li>
						<a href='#contacts'>Контакты</a>
					</li>
				</ul>
			</nav>

			<button
				class={cls.mobileNavBtn}
				aria-label='Открыть мобильное меню'
				aria-expanded='false'
			>
				<div class='nav-icon'></div>
			</button>
		</div>
	</div>
</header>
