---
import cls from './header.module.scss';
---

<header class={cls.header}>
	<div class='container'>
		<div class={cls.wrapper}>
			<div class={cls.logo} aria-label='Логотип Acrobatics'>
				<a href='#' class={cls.logoLink}>
					<span class={cls.logoAccent}>Acrobatics</span>
				</a>
			</div>
			<nav class={cls.nav} aria-label='Основная навигация'>
				<ul class={cls.navList}>
					<li class={cls.navItem}>
						<a href='#about' class={cls.navLink}>Наши тренеры</a>
					</li>
					<li class={cls.navItem}>
						<a href='#programs' class={cls.navLink}>Программа</a>
					</li>
					<li class={cls.navItem}>
						<a href='#gallery' class={cls.navLink}>Галерея</a>
					</li>
					<li class={cls.navItem}>
						<a href='#reviews' class={cls.navLink}>Отзывы</a>
					</li>
					<li class={cls.navItem}>
						<a href='#contacts' class={cls.navLink}>Контакты</a>
					</li>
				</ul>
			</nav>
			<button
				id='mobile-nav-btn'
				class={`${cls.mobileNavBtn} mobile-nav-btn`}
				aria-label='Открыть мобильное меню'
				aria-expanded='false'
			>
				<div class='nav-icon'></div>
			</button>
		</div>
	</div>
</header>
